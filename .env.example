# Copy to .env for local Docker Compose development. Never commit real secrets.
POSTGRES_DB=agentguard
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://agentguard:change-this-local-password@postgres:5432/agentguard
REDIS_URL=redis://redis:6379/0
AGENTGUARD_ENV=development
AGENTGUARD_LOG_LEVEL=INFO
AGENTGUARD_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

